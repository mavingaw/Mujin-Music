# Copy to .env (which git ignores) and fill in. Nothing here is needed again
# after the runner has registered once.

# Gitea's address, as in its ROOT_URL.
GITEA_INSTANCE_URL=http://192.168.1.58:3002

# Site Administration -> Actions -> Runners -> Create new runner.
GITEA_RUNNER_REGISTRATION_TOKEN=

# A name per machine, e.g. mujinserver or frontdesk.
GITEA_RUNNER_NAME=mujinserver

# Where the runner keeps its registration and its action cache.
# Unraid: /mnt/storage/appdata/mujin-gitea-runner. Ubuntu: /srv/mujin-gitea-runner.
RUNNER_DATA=/mnt/storage/appdata/mujin-gitea-runner
