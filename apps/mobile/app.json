{
  "expo": {
    "name": "Mujin Music",
    "slug": "mujin-music",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/mujin-icon.png",
    "scheme": "parson",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "bundleIdentifier": "music.mujin.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Mujin Music finds music libraries running on your local network.",
        "NSBonjourServices": ["_parson._tcp"]
      },
      "buildNumber": "1001000"
    },
    "android": {
      "package": "music.mujin.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/mujin-adaptive-foreground.png",
        "backgroundImage": "./assets/images/mujin-adaptive-background.png",
        "monochromeImage": "./assets/images/mujin-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1001000
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/mujin-icon.png"
    },
    "plugins": [
      "./plugins/with-fast-player-transitions",
      "./plugins/with-android-style-compatibility",
      "./plugins/with-android-lint-stability",
      "./plugins/with-android-release-signing",
      "./plugins/with-license-assets",
      "expo-router",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "expandedController": true,
          "androidPlayServicesCastFrameworkVersion": "22.3.1"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": false,
          "androidFSTypes": ["mediaPlayback"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050506",
          "image": "./assets/images/mujin-splash.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
