{
  "name": "parson-music-desktop",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Mujin Music desktop client for Linux, macOS, and Windows",
  "homepage": "https://github.com/mavingaw/Mujin-Music",
  "author": {
    "name": "Mujin Music"
  },
  "desktopName": "com.parsonlabs.parson.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop:dev": "node scripts/prepare-sidecar.cjs && electron .",
    "desktop:build": "node scripts/prepare-sidecar.cjs && node scripts/build.cjs",
    "desktop:test": "node --test electron/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "music.mujin.desktop",
    "productName": "Mujin Music",
    "copyright": "Mujin Music. Based on Parson by ParsonLabs. GPL-3.0-only.",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "../../target/release/bundle/electron"
    },
    "toolsets": {
      "appimage": "1.0.3",
      "wine": "1.0.1"
    },
    "files": [
      "electron/main.cjs",
      "electron/linux-installer.cjs",
      "electron/linux-relaunch.cjs",
      "electron/backend-trust.cjs",
      "electron/failure-state.cjs",
      "electron/navigation.cjs",
      "electron/mdns.cjs",
      "electron/server-config.cjs",
      "electron/server-monitor.cjs",
      "electron/server-service.cjs",
      "electron/server-host.cjs",
      "electron/session-vault.cjs",
      "electron/servers.html",
      "electron/preload.cjs",
      "electron/startup.html",
      "electron/startup-error.html",
      "package.json",
      "electron/updates.cjs"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "electron/bin",
        "to": ".",
        "filter": [
          "parson-music-server",
          "parson-music-server.exe",
          "ParsonMusicServer.exe"
        ]
      },
      {
        "from": "../web/public/icons/icon-512.png",
        "to": "parson.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Audio;Player",
      "executableName": "parson",
      "icon": "../web/public/icons/icon-512.png",
      "maintainer": "Mujin Music",
      "syncDesktopName": true,
      "artifactName": "Mujin-Music-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../../crates/windows-server/parson.ico",
      "executableName": "Mujin Music",
      "signExts": [
        ".exe",
        ".dll",
        ".node"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/parson-music-server"
      ],
      "minimumSystemVersion": "13.0",
      "artifactName": "Mujin-Music-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Mujin Music uses your local network to serve your music library to your devices.",
        "NSBonjourServices": [
          "_parson._tcp"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mujin Music",
      "artifactName": "Mujin-Music-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Mujin-Music-${version}-${arch}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mavingaw",
        "repo": "Mujin-Music",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
